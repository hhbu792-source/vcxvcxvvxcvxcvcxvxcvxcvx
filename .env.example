# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=BURAYA_BOT_TOKENINI_YAZ

# Discord Developer Portal -> General Information -> Application ID (Opsiyonel)
CLIENT_ID=

# Slash komutlarinin aninda yuklenmesi icin sunucu ID (Opsiyonel)
GUILD_ID=

# Varsayilan karantina rolu adi
QUARANTINE_ROLE_NAME=KARANTINA

# Varsayilan guvenlik log kanali adi
DEFAULT_LOG_CHANNEL_NAME=defender-log

# Yedekleme (snapshot) yenileme suresi (dakika)
SNAPSHOT_INTERVAL_MINUTES=15
